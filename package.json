{
  "name": "codex-antigravity-subagent-mcp",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge that lets Codex delegate work to Google Antigravity CLI.",
  "license": "MIT",
  "author": "zamatewi-cell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamatewi-cell/antigravity-subagent-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "antigravity",
    "subagent",
    "gemini"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "dashboard": "node src/dashboard.mjs",
    "test": "node test/smoke.mjs",
    "test:dashboard": "node test/dashboard.test.mjs",
    "test:progress": "node test/progress.test.mjs",
    "test:counterexamples": "node test/counterexamples.test.mjs",
    "test:teamwork": "node test/teamwork-smoke.mjs",
    "test:diagnostics": "node test/diagnostics.test.mjs",
    "test:teamwork-full": "node test/full-teamwork-readonly.mjs",
    "test:lifecycle": "node test/lifecycle.test.mjs",
    "test:cancel": "node test/cancel-consistency.test.mjs",
    "test:pagination": "node test/pagination.test.mjs",
    "test:sse-delta": "node test/sse-delta.test.mjs",
    "test:dag-topology": "node test/dag-topology.test.mjs",
    "test:hitl": "node test/hitl.test.mjs",
    "test:stream": "node test/hitl-stream-transport.test.mjs",
    "test:stream-e2e": "node test/hitl-real-agy.e2e.test.mjs",
    "test:offline": "node test/counterexamples.test.mjs && node test/dashboard.test.mjs && node test/cancel-consistency.test.mjs && node test/lifecycle.test.mjs && node test/progress.test.mjs && node test/diagnostics.test.mjs && node test/pagination.test.mjs && node test/sse-delta.test.mjs && node test/dag-topology.test.mjs && node test/hitl.test.mjs && node test/hitl-stream-transport.test.mjs",
    "test:all": "node test/smoke.mjs && npm run test:offline",
    "test:live": "node test/live-validation.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
